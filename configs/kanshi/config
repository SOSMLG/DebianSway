# kanshi — automatic output profiles for hotplug/dock.
# sway execs `kanshi` at session start; these profiles apply when the listed
# outputs appear. Profile names are arbitrary. Add your dock/HDMI/DP outputs.
#
# Find your outputs with `wlr-randr` (or `swaymsg -t get_outputs`).
# On profile match the output layout/scale/mode is reconfigured live.

profile laptop {
  output eDP-1 enable adaptive_sync off
}

# Example dock profile (adjust to your actual external outputs/positions):
