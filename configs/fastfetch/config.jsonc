{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "color": {
            "keys": "blue"
        },
        "separator": " => "
    },
    "logo": {
        "type": "builtin",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 2
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        "separator",
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "swap",
            "key": "Swap"
        },
        {
            "type": "disk",
            "key": "Disk"
        },
        "separator",
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "wm-theme",
            "key": "Theme"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "terminalfont",
            "key": "Font"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        "separator",
        {
            "type": "localip",
            "key": "Local IP"
        },
        {
            "type": "battery",
            "key": "Battery"
        },
        {
            "type": "break"
        },
        "colors"
    ]
}
