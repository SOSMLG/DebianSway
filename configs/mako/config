# mako notification daemon — RENDERED by the debsway theme engine. Do not edit.
font=JetBrainsMono Nerd Font 12
background-color=#16181d
text-color=#d8d3c8
border-color=#e8a33d
border-size=2
border-radius=8
padding=12,14
margin=8
default-timeout=4000
icons=1
max-icon-size=48
max-visible=5
anchor=top-center
width=380
history=1
on-button-left=invoke-default-action
on-button-right=dismiss-all

[urgency=low]
background-color=#202329
text-color=#9a9aa2
border-color=#30343b
default-timeout=4000

[urgency=critical]
background-color=#e8a33d
text-color=#16181d
border-color=#d2992f
default-timeout=0

# Do-not-disturb toggle target: `debsway toggle dnd` switches to this mode.
[mode=dnd]
invisible=1