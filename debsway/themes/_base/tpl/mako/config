# mako notification daemon — RENDERED by the debsway theme engine. Do not edit.
font=JetBrainsMono Nerd Font 12
background-color=#@@BG@@
text-color=#@@TEXT@@
border-color=#@@ACCENT@@
border-size=2
border-radius=8
padding=12,14
margin=8
default-timeout=5000
icons=1
max-icon-size=48
max-visible=5
anchor=top-center
width=420
history=1
on-button-left=invoke-default-action
on-button-right=dismiss-all

[urgency=low]
background-color=#@@MANTLE@@
text-color=#@@SUBTEXT0@@
border-color=#@@SURFACE2@@
default-timeout=4000

[urgency=critical]
background-color=#@@ACCENT@@
text-color=#@@CRUST@@
border-color=#@@YELLOW@@
default-timeout=0

# Do-not-disturb toggle target: `debsway toggle dnd` switches to this mode.
[mode=dnd]
invisible=1